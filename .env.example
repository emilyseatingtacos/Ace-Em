# Facebook Graph API credentials
PAGE_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# The Vet CSR Facebook page defaults
PAGE_USERNAME=thevetcsr
FACEBOOK_PAGE_URL=https://www.facebook.com/thevetcsr/

# Optional: set this if you already know the numeric Facebook Page ID.
# When PAGE_ID is set, the script uses it instead of PAGE_USERNAME.
PAGE_ID=

# Scaled extraction settings
GRAPH_API_VERSION=v21.0
POST_LIMIT=500
PAGE_SIZE=100
REQUEST_TIMEOUT=30
OUTPUT_DIR=.

# Optional filters accepted by the Graph API (examples: 2026-01-01, 2026-06-01)
SINCE=
UNTIL=

# Set to true to append post rows instead of refreshing facebook_posts.csv.
APPEND_POSTS=false

# Set to true to run locally without Facebook credentials using representative sample data.
SAMPLE_DATA=false
